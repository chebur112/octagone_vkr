Функция QueryPOST(Запрос)

	Попытка
		Данные = ПрочитатьТело(Запрос);
		УстановитьПривилегированныйРежим(Истина);
		Результат = ВыполнитьЗапрос(Данные["text"], Данные["params"]);
		УстановитьПривилегированныйРежим(Ложь);
	Исключение
		Результат = Новый Структура("ok, error", Ложь,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат ОтветJSON(Результат);

КонецФункции

Функция metadataGET(Запрос)

	Объекты = Новый Массив;
	ДобавитьОбъекты(Объекты, Метаданные.Справочники, "Справочник");
	ДобавитьОбъекты(Объекты, Метаданные.Документы, "Документ");
	ДобавитьОбъекты(Объекты, Метаданные.Перечисления, "Перечисление");
	ДобавитьОбъекты(Объекты, Метаданные.РегистрыСведений, "РегистрСведений");
	ДобавитьОбъекты(Объекты, Метаданные.РегистрыНакопления, "РегистрНакопления");
	ДобавитьОбъекты(Объекты, Метаданные.РегистрыБухгалтерии, "РегистрБухгалтерии");
	ДобавитьОбъекты(Объекты, Метаданные.РегистрыРасчета, "РегистрРасчета");

	Возврат ОтветJSON(Новый Структура("objects", Объекты));

КонецФункции

Функция lookupPOST(Запрос)

	Попытка
		Данные = ПрочитатьТело(Запрос);
		Элементы = НайтиЭлементы(Данные["catalog"], Данные["text"]);
		Результат = Новый Структура("ok, items", Истина, Элементы);
	Исключение
		Результат = Новый Структура("ok, error", Ложь,
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат ОтветJSON(Результат);

КонецФункции


Функция НайтиЭлементы(ИмяСправочника, Текст)

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(Строка(ИмяСправочника));
	Если ОбъектМетаданных = Неопределено Или Не Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		ВызватьИсключение "Справочник не найден: " + ИмяСправочника;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 10
		|	Ссылка,
		|	Наименование
		|ИЗ
		|	" + ОбъектМетаданных.ПолноеИмя() + "
		|ГДЕ
		|	Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|	И НЕ ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Наименование");
	Запрос.УстановитьПараметр("Шаблон", "%" + ЭкранироватьДляПодобно(Строка(Текст)) + "%");

	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);

	Элементы = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Элементы.Добавить(Новый Структура("id, name", XMLСтрока(Выборка.Ссылка), Выборка.Наименование));
	КонецЦикла;

	Возврат Элементы;

КонецФункции

// Символы % _ [ ] ^ в ПОДОБНО служебные: без экранирования "50%" искало бы "50" с чем угодно после.
Функция ЭкранироватьДляПодобно(Текст)

	Результат = СтрЗаменить(Текст, "~", "~~");
	Для Каждого Символ Из СтрРазделить("%,_,[,],^", ",") Цикл
		Результат = СтрЗаменить(Результат, Символ, "~" + Символ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ДобавитьОбъекты(Объекты, Коллекция, Вид)

	ЭтоРегистр = СтрНачинаетсяС(Вид, "Регистр");

	Для Каждого Объект Из Коллекция Цикл

		ОписаниеОбъекта = Новый Структура("name, synonym, type",
			Объект.ПолноеИмя(), Объект.Представление(), Вид);

		Если Вид = "Перечисление" Тогда
			ОписаниеОбъекта.Вставить("values", ЗначенияПеречисления(Объект));
			Объекты.Добавить(ОписаниеОбъекта);
			Продолжить;
		КонецЕсли;

		Поля = Новый Массив;
		ДобавитьПоля(Поля, Объект.СтандартныеРеквизиты, "СтандартныйРеквизит");
		Если ЭтоРегистр Тогда
			ДобавитьПоля(Поля, Объект.Измерения, "Измерение");
			ДобавитьПоля(Поля, Объект.Ресурсы, "Ресурс");
		КонецЕсли;
		ДобавитьПоля(Поля, Объект.Реквизиты, "Реквизит");
		ОписаниеОбъекта.Вставить("fields", Поля);

		Если Вид = "Справочник" Или Вид = "Документ" Тогда
			ОписаниеОбъекта.Вставить("tables", ТабличныеЧасти(Объект));
		КонецЕсли;

		Если Вид = "Документ" Тогда
			Движения = Новый Массив;
			Для Каждого Регистр Из Объект.Движения Цикл
				Движения.Добавить(Регистр.ПолноеИмя());
			КонецЦикла;
			ОписаниеОбъекта.Вставить("movements", Движения);
		КонецЕсли;

		Если ЭтоРегистр Тогда
			ДобавитьСвойстваРегистра(ОписаниеОбъекта, Объект, Вид);
		КонецЕсли;

		Объекты.Добавить(ОписаниеОбъекта);

	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПоля(Поля, Коллекция, Роль)

	Для Каждого Поле Из Коллекция Цикл
		ОписаниеПоля = Новый Структура("name, synonym, role, type",
			Поле.Имя,
			?(ПустаяСтрока(Поле.Синоним), Поле.Имя, Поле.Синоним),
			Роль,
			ПредставлениеТипа(Поле.Тип));
		Поля.Добавить(ОписаниеПоля);
	КонецЦикла;

КонецПроцедуры

Функция ПредставлениеТипа(ОписаниеТипов)

	Типы = ОписаниеТипов.Типы();
	// У полей вроде Регистратор сотни типов документов, перечислять их в каталоге бессмысленно.
	Если Типы.Количество() > 5 Тогда
		Возврат "Составной";
	КонецЕсли;

	Имена = Новый Массив;
	Для Каждого Тип Из Типы Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		Если ОбъектМетаданных = Неопределено Тогда
			Имена.Добавить(Строка(Тип));
		Иначе
			Имена.Добавить(ОбъектМетаданных.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Имена, ", ");

КонецФункции

Функция ТабличныеЧасти(Объект)

	Таблицы = Новый Массив;
	Для Каждого ТабличнаяЧасть Из Объект.ТабличныеЧасти Цикл
		Поля = Новый Массив;
		ДобавитьПоля(Поля, ТабличнаяЧасть.СтандартныеРеквизиты, "СтандартныйРеквизит");
		ДобавитьПоля(Поля, ТабличнаяЧасть.Реквизиты, "Реквизит");
		// Имя сразу в том виде, в каком таблица пишется в запросе: Документ.Х.Запасы
		Таблицы.Добавить(Новый Структура("name, synonym, fields",
			Объект.ПолноеИмя() + "." + ТабличнаяЧасть.Имя, ТабличнаяЧасть.Представление(), Поля));
	КонецЦикла;

	Возврат Таблицы;

КонецФункции

Функция ЗначенияПеречисления(Объект)

	Значения = Новый Массив;
	Для Каждого Значение Из Объект.ЗначенияПеречисления Цикл
		Значения.Добавить(Новый Структура("name, synonym", Значение.Имя, Значение.Представление()));
	КонецЦикла;

	Возврат Значения;

КонецФункции

Процедура ДобавитьСвойстваРегистра(ОписаниеОбъекта, Объект, Вид)

	ВиртуальныеТаблицы = Новый Массив;

	Если Вид = "РегистрНакопления" Тогда
		Если Объект.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
			ОписаниеОбъекта.Вставить("register_kind", "Остатки");
			ВиртуальныеТаблицы = СтрРазделить("Остатки,Обороты,ОстаткиИОбороты", ",");
		Иначе
			ОписаниеОбъекта.Вставить("register_kind", "Обороты");
			ВиртуальныеТаблицы.Добавить("Обороты");
		КонецЕсли;
	ИначеЕсли Вид = "РегистрСведений" Тогда
		Если Объект.ПериодичностьРегистраСведений
			<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			ВиртуальныеТаблицы = СтрРазделить("СрезПоследних,СрезПервых", ",");
		КонецЕсли;
	ИначеЕсли Вид = "РегистрБухгалтерии" Тогда
		ВиртуальныеТаблицы = СтрРазделить("Остатки,Обороты,ОстаткиИОбороты,ОборотыДтКт,ДвиженияССубконто", ",");
	КонецЕсли;

	ОписаниеОбъекта.Вставить("virtual_tables", ВиртуальныеТаблицы);

КонецПроцедуры

Функция ВыполнитьЗапрос(Текст, Параметры)

	МаксимумСтрок = 1000;

	Запрос = Новый Запрос(Текст);
	Если Параметры <> Неопределено Тогда
		Для Каждого Параметр Из Параметры Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, ЗначениеПараметра(Параметр.Значение));
		КонецЦикла;
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();

	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Колонка.Имя);
	КонецЦикла;

	Строки = Новый Массив;
	Усечено = Ложь;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Строки.Количество() = МаксимумСтрок Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;
		Строка = Новый Массив;
		Для Каждого ИмяКолонки Из Колонки Цикл
			Строка.Добавить(ЗначениеДляJSON(Выборка[ИмяКолонки]));
		КонецЦикла;
		Строки.Добавить(Строка);
	КонецЦикла;

	Возврат Новый Структура("ok, columns, rows, truncated", Истина, Колонки, Строки, Усечено);

КонецФункции

// {"type": "date", "value": "2026-11-12T00:00:00"}
// {"type": "ref", "catalog": "Справочник.СтруктурныеЕдиницы", "id": "<GUID>"}
// остальные типы (number, string, boolean) передаются как есть.
Функция ЗначениеПараметра(Описание)

	ТипПараметра = Описание["type"];

	Если ТипПараметра = "date" Тогда
		Возврат XMLЗначение(Тип("Дата"), Описание["value"]);
	ИначеЕсли ТипПараметра = "ref" Тогда
		// "Справочник.Склады" -> "СправочникСсылка.Склады"; XML-представление ссылки — её GUID
		ИмяТипа = СтрЗаменить(Описание["catalog"], ".", "Ссылка.");
		Возврат XMLЗначение(Тип(ИмяТипа), Описание["id"]);
	Иначе
		Возврат Описание["value"];
	КонецЕсли;

КонецФункции

Функция ЗначениеДляJSON(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	ИначеЕсли Значение = Null Или Значение = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат Строка(Значение);
	КонецЕсли;

КонецФункции

Функция ПрочитатьТело(Запрос)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Данные;

КонецФункции

Функция ОтветJSON(Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Возврат Ответ;

КонецФункции

#КонецОбласти
